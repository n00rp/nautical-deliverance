# Copy to infra/.env (gitignored). Development defaults only; never use in production.
ND_DB_SUPERUSER_PASSWORD=dev-superuser-password
ND_DB_OWNER_PASSWORD=dev-owner-password
ND_DB_APP_PASSWORD=dev-app-password
# Dev Keycloak admin console login (http://localhost:8081). Test credentials only.
ND_KEYCLOAK_ADMIN_PASSWORD=dev-keycloak-admin-password
# Seeds the demo organizations (Acme Shipping, Borealis Tankers). Never true outside dev.
ND_SEED=dev
# Image tag and commit shown by /api/v1/health; CI sets both.
ND_IMAGE_TAG=dev
ND_GIT_SHA=dev
