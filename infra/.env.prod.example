# Copy to infra/.env.prod on the server (mode 600, git-ignored) and replace every CHANGE_ME.
# Start with: docker compose --env-file infra/.env.prod -f infra/docker-compose.yml -f infra/docker-compose.prod.yml up -d --build
# Public hostname served by Caddy (Let's Encrypt). Use `localhost` only for local checks.
ND_PUBLIC_HOST=nd-pilot.duckdns.org
# Generate each secret with: openssl rand -base64 24
ND_DB_SUPERUSER_PASSWORD=CHANGE_ME
ND_DB_OWNER_PASSWORD=CHANGE_ME
ND_DB_APP_PASSWORD=CHANGE_ME
ND_DB_KEYCLOAK_PASSWORD=CHANGE_ME
# Keycloak admin console login (reachable by SSH tunnel to the keycloak container only).
ND_KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
# Commit shown by /api/v1/health; the deploy workflow sets it.
ND_GIT_SHA=CHANGE_ME
